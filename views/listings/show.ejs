<% layout('layouts/boilerplate') -%>

<div class="row mt-3">
  <div class="col-8 offset-2">

    <!-- Listing Card -->
    <div class="card listing_card">
      <h3 class="p-3"><%= listingdata.title %></h3>

      <img class="card-img-top show-img" src="<%= listingdata.image.url %>" alt="listing image">

      <div class="card-body">
        <p class="card-text"><i>@<%= listingdata.owner.username %></i></p>
        <p class="card-text"><%= listingdata.description %></p>
        <p class="card-text">&#8377;<%= listingdata.price.toLocaleString("en-IN") %></p>
        <p class="card-text"><%= listingdata.location %></p>
        <p class="card-text"><%= listingdata.country %></p>
      </div>
    </div>

    <!-- Buttons -->
    <% if(currUser && listingdata.owner._id.equals(currUser._id)){ %>
    <div class="btns mt-3">
      <a href="/listings/<%= listingdata._id %>/edit" class="btn btn-dark">Edit</a>

      <form method="post" action="/listings/<%= listingdata._id %>?_method=DELETE" class="d-inline ms-2">
        <button class="btn btn-dark">Delete</button>
      </form>
    </div>
    <% } %>
    <% if(currUser){ %>
    <!-- Review Form -->
    <div class="mt-4">
      <hr>
      <h4>Review</h4>

      <form action="/listings/<%= listingdata._id %>/reviews" method="post" novalidate class="needs-validation">

        <div class="mb-3 mt-3">
          <label for="rating" class="form-label">Rating</label>
          <input type="range" class="form-range" min="1" max="5" id="rating" name="review[rating]">
        </div>

        <div class="mb-3">
          <label for="comment" class="form-label">Comment</label>
          <textarea name="review[comment]" id="comment" rows="5" class="form-control" required></textarea>
          <div class="invalid-feedback">
            Please add some comments for review
          </div>
        </div>
        <button class="btn btn-outline-dark mb-3">Submit</button>
      </form>
    </div>
    <% } %>
    <!-- All Reviews -->
    <h5><b>All Reviews</b></h5>

    <div class="row">
      <% for(let review of listingdata.reviews){ %>

        <div class="card col-5 ms-2 mb-3">
          <div class="card-body">
            <h5 class="card-title"><i>@<%=review.author.username%></i></h5>
            <p class="card-text"><%= review.comment %></p>
            <p class="card-text"><%= review.rating %> Stars</p>
          </div>

          <form class="mb-3" method="post"
            action="/listings/<%= listingdata._id %>/reviews/<%= review._id %>?_method=DELETE">

            <button class="btn btn-sm btn-dark ">Delete</button>
          </form>
        </div>

      <% } %>
    </div>

  </div>
</div>